# =============================================
# ENVIRONMENT TEMPLATE  (.env.example)
# =============================================
# Copy this file to .env and fill in real values.

# ---- MySQL (local) ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=auth_db

# ---- MySQL (production — Aiven) ----
# DATABASE_URL=mysql://avnadmin:PASSWORD@HOST:PORT/DATABASE?ssl-mode=REQUIRED

# ---- JWT ----
JWT_SECRET=
JWT_EXPIRES_IN=1h

# ---- Server ----
PORT=5000

# ---- CORS ----
# FRONTEND_URL=https://your-app.vercel.app

# ---- SMTP (Email OTP) ----
# Use any SMTP provider: Gmail (App Password), Brevo, Mailtrap, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
# SMTP_FROM=noreply@sprint30.app
